FROM debian:bookworm AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl build-essential libssl-dev zlib1g-dev util-linux \
    && rm -rf /var/lib/apt/lists/*
ARG MTPROXY_COMMIT=f36d8af769ffaeac36978d38c2c0f6d1104c2137
ARG MTPROXY_SHA256=919795c416b870670841a21d1930ad97a24c7b84b9eb8c6f9e3de32f2fdf4655
WORKDIR /build
RUN curl --fail --silent --show-error --location \
      --proto '=https' --proto-redir '=https' --tlsv1.2 \
      -o /tmp/mtproxy.tar.gz \
      "https://github.com/TelegramMessenger/MTProxy/archive/${MTPROXY_COMMIT}.tar.gz" \
    && echo "${MTPROXY_SHA256}  /tmp/mtproxy.tar.gz" | sha256sum -c - \
    && tar --strip-components=1 -xzf /tmp/mtproxy.tar.gz \
    && make -j4 \
    && test -x objs/bin/mtproto-proxy

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl jq iproute2 libssl3 zlib1g bash \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/objs/bin/mtproto-proxy /usr/local/bin/mtproto-proxy
COPY docker/mtproxy-entrypoint.sh /usr/local/bin/mtproxy-entrypoint.sh
RUN chmod 0755 /usr/local/bin/mtproxy-entrypoint.sh \
    && mkdir -p /var/lib/mtproxy
ENTRYPOINT ["/usr/local/bin/mtproxy-entrypoint.sh"]
