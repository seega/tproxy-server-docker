FROM golang:1.26-bookworm AS builder
WORKDIR /source
COPY upstream/go.mod upstream/go.sum ./
RUN go mod download
COPY upstream/ ./
RUN go test ./... && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags='-s -w' -o /out/tproxy-server ./cmd/tproxy-server

FROM alpine:3.24
RUN apk add --no-cache ca-certificates
COPY --from=builder /out/tproxy-server /usr/local/bin/tproxy-server
ENTRYPOINT ["/usr/local/bin/tproxy-server"]
